def branchMap = [
    'develop': "internal_testing",
    'network': "network_testing",
    'main'   : "default"
]

def steamBranch = "unknown"
def commitMsg = "unknown"
def isMerge = false
def botsAdminRole = "<@&1483456172567822378>"
def programmerRole = "<@&1476249214106472592>"

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        lock ('project-anomaly-build-queue')
    }

    environment {
        UNITY_PATH = '"C:\\Program Files\\Unity\\Hub\\Editor\\6000.3.10f1\\Editor\\Unity.exe"'
        CREDS = credentials('MY_SECRET_ID') 
        ANOMALY_DISCORD_WEBHOOK_URL = credentials('PROJECT_ANOMALY_DISCORD_WEBHOOK_BUILD_RESULT')
        ANOMALY_DISCORD_WEBHOOK_MERGE_URL = credentials('PROJECT_ANOMALY_DISCORD_WEBHOOK_MERGE')
        UNITY_LOG_PATH = "${env.WORKSPACE}\\unity_build.log"
    }

    stages {

       stage('Checkout') {
            steps {
                checkout scm
                
                script{
                    bat "git clean -fdx -e Library/"
                    
                    commitMsg = bat(script: "@echo off\ngit log -1 --pretty=%%s", returnStdout: true).trim().split('\n').last()
                    def parentHashes = bat(script: "@echo off\ngit log -1 --pretty=%%p", returnStdout: true).trim().split('\n').last()
                    isMerge = parentHashes.tokenize(' ').size() > 1
                }
            }
        }

        stage('SonarQube Code Review') {
            when {
                changeRequest()
            }
            steps {
                script {
                    discordSend title: "🔎 Code Review: PR-${env.CHANGE_ID}",
                        description: "${env.AUTHOR_PING} \nSir, I am running isolated SonarQube static analysis on your Pull Request #${env.CHANGE_ID}.",
                        link: env.BUILD_URL,
                        color: 16766720,
                        webhookURL: "${env.ANOMALY_DISCORD_WEBHOOK_URL}"
                    
                    def scannerHome = tool 'SonarScanner' 
                    
                    withSonarQubeEnv('SonarCloud') { 
                        bat """
                        "${scannerHome}\\bin\\sonar-scanner.bat" -Dsonar.organization="anomalyproject-1" -Dsonar.projectKey="AnomalyProject_Studio-Proj-26S1" -Dsonar.projectName="Project Anomaly" -Dsonar.sources="Assets/Code/Scripts" -Dsonar.language=cs
                        """
                    }
                }
            }
        }

        stage('Merge Notification') {
            when {
                expression { return isMerge }
            }
            steps {
                script {
                    bat """powershell -Command "Invoke-RestMethod -Uri '${env.ANOMALY_DISCORD_WEBHOOK_MERGE_URL}' -Method Post -Body (@{content='${programmerRole} - Sir, a new merge has been detected on ${env.BRANCH_NAME}!'} | ConvertTo-Json) -ContentType 'application/json'" """

                    discordSend title: "🔀 New Merge: ${env.BRANCH_NAME}",
                        description: "${programmerRole} \nSir, a merge was detected on ${env.BRANCH_NAME}. \n**Commit:** ${commitMsg}",
                        link: env.BUILD_URL,
                        result: 'ABORTED',
                        webhookURL: "${env.ANOMALY_DISCORD_WEBHOOK_MERGE_URL}"
                }
            }
        }

        stage('Unity Build') {
            steps {
                bat "${UNITY_PATH} -batchmode -nographics -quit -projectPath \"%cd%\" -executeMethod BuildScript.PerformBuild -logFile \"${UNITY_LOG_PATH}\""
                sleep time: 10, unit: 'SECONDS'
            }
        }

        stage('Verify Build') {
            steps {
                script {
                    def logFile = readFile(file: UNITY_LOG_PATH)
                    if (logFile.contains('Build Finished, Result: Failure')) {
                        error 'Unity build reported a failure in the logs.'
                    }
                }
            }
        }

        stage('Deploy to Steam') {
            steps {
                script {
                    steamBranch = branchMap.get(env.BRANCH_NAME, "internal_testing")
            
                    def contentRoot = "${WORKSPACE}\\Builds"
                    def outputRoot = "${WORKSPACE}\\SteamOutput"
                    def vdfPath = "${WORKSPACE}\\BuildScripts\\app_build.vdf"

                    bat "if not exist Builds mkdir Builds"
                    bat "if not exist SteamOutput mkdir SteamOutput"

                    def depotVdfPath = "${WORKSPACE}\\BuildScripts\\depot_build_4383781.vdf"

                    echo "Alfred: Customizing the VDF for this specific workspace master Bruce..."
                    
                    bat """powershell -Command "(Get-Content '${vdfPath}') -replace 'STEAM_BRANCH_PLACEHOLDER','${steamBranch}' -replace 'CONTENT_ROOT_PLACEHOLDER','${contentRoot}' -replace 'OUTPUT_ROOT_PLACEHOLDER','${outputRoot}' | Set-Content '${vdfPath}'" """
                    bat """powershell -Command "(Get-Content '${depotVdfPath}') -replace 'CONTENT_ROOT_PLACEHOLDER','${contentRoot}' -replace 'OUTPUT_ROOT_PLACEHOLDER','${outputRoot}' | Set-Content '${depotVdfPath}'" """

                    bat "\"C:\\Tools\\steamcmd\\steamcmd.exe\" +login %CREDS_USR% %CREDS_PSW% +run_app_build \"${vdfPath}\" +quit"
                }
            }
        }
    }

    post {
        success {
            script {
                discordSend title: "✅ Build Success: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Splendid news Sir, the build and the Deployment to Steam (${env.BRANCH_NAME}) were successful.\n**Commit:** ${commitMsg}\n**Steam Depo:** ${steamBranch}",
                    link: env.BUILD_URL,
                    result: 'SUCCESS',
                    webhookURL: "${env.ANOMALY_DISCORD_WEBHOOK_URL}"
            }
        }

        aborted {
            script {
                discordSend title: "⚪ Build Aborted: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Sir, the build was aborted. Just like Jeeves, am i Right ?\n This is a manual operation so no commit descreption will be provided.",
                    link: env.BUILD_URL,
                    result: 'ABORTED',
                    webhookURL: "${env.ANOMALY_DISCORD_WEBHOOK_URL}"
            }
        }

        failure {
            script {
                discordSend title: "❌ Build Failed: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Most unfortunate news Sir, the build for (${env.BRANCH_NAME}) has Failed.\n**Commit:** ${commitMsg}\n**Steam Depo:** ${steamBranch}",
                    link: env.BUILD_URL,
                    result: 'FAILURE',
                    webhookURL: "${env.ANOMALY_DISCORD_WEBHOOK_URL}"

                    if (fileExists(UNITY_LOG_PATH)) {
                    echo "Alfred: Dispatching the failure logs for investigation..."
                    bat "curl.exe -F \"file=@${UNITY_LOG_PATH}\" %ANOMALY_DISCORD_WEBHOOK_URL%"
                }
            }
        }
    }
}