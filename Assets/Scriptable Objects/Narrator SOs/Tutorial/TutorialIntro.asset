  voiceClip: {fileID: 8300000, guid: a3223684fbd81f84482ff187249c1eef, type: 3}
  subtitles:
  - timestamp: 0.1
    speakerName: Narrator
    dialogueText: Welcome, participant.
  - timestamp: 2.4
    speakerName: Narrator
    dialogueText: This training exercise will guide you through the basic skills
      you'll need in your time here with us.
  - timestamp: 9.1
    speakerName: Narrator
    dialogueText: It is important that you understand the likely dangers of the profession.
  - timestamp: 14.6
    speakerName: Narrator
    dialogueText: You must always be conscious of your surroundings, for even minor
      changes in the environment should be treated as an urgent matter.
  - timestamp: 23.5
    speakerName: Narrator
    dialogueText: Please take a moment to memorize the training area.
  finalSubOffset: 3.7
