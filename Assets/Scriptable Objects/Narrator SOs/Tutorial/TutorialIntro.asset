  m_Script: {fileID: 11500000, guid: 514c9d3afac56964996fec7a1d6e0ed4, type: 3}
  m_Name: TutorialIntro
  m_EditorClassIdentifier: Assembly-CSharp::NarrationEntry
  triggerID: TutorialIntro
  firstTimeOnly: 0
  voiceClip: {fileID: 8300000, guid: 9a2f885ff5aea1744904e4e5bff9684c, type: 3}
  subtitles:
  - timestamp: 0.1
    speakerName: Narrator
    dialogueText: Welcome, participant.
  - timestamp: 2.37
    speakerName: Narrator
    dialogueText: This training exercise covers the fundamentals you'll need during
      your time here.
  - timestamp: 9
    speakerName: Narrator
    dialogueText: The first time you enter an environment, it will appear as intended.
  - timestamp: 14
    speakerName: Narrator
    dialogueText: Treat it as your baseline and memorize its details carefully.
  - timestamp: 18.7
    speakerName: Narrator
    dialogueText: Future visits may disagree with it.
  - timestamp: 21.7
    speakerName: Narrator
    dialogueText: Please take a moment to look around.
  - timestamp: 24
    speakerName: Narrator
    dialogueText: Once you're confident, head to the elevator.
  finalSubOffset: 3.7
